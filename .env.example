# Copie este arquivo para `.env` e preencha com os valores do seu projeto.
# NUNCA versionar o `.env` real (chaves podem vazar se forem commitadas).
# Variáveis do Supabase vêm em duplicata: prefixo `SUPABASE_` (server-side
# via @supabase) e `VITE_SUPABASE_` (cliente). Ambas apontam para o mesmo projeto.
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# TTS — limites opcionais para a narração de novels (defaults entre parênteses)
# TTS_MAX_CHARS=1200
# TTS_PER_MINUTE_REQUESTS=20
# TTS_PER_MINUTE_CHARS=6000
# TTS_PER_DAY_CHARS=60000

# Deploy: chaves secretas de produção ficam em .dev.vars (Cloudflare) ou
# variáveis de ambiente do provedor — NUNCA no .env versionado.